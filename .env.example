# Copy this file to .env and fill in real values. Never commit .env itself.

# Groq (LLM generation) — https://console.groq.com/keys
GROQ_API_KEY=

# Google AI Studio (Gemini embeddings) — https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Chroma (vector store) — local directory it persists data to, created automatically.
# Only used in embedded mode, i.e. when CHROMA_HOST below is empty.
CHROMA_PERSIST_DIR=project/storage/.chroma_data

# Chroma server host/port — leave both empty/default for local (non-Docker)
# development, where Chroma runs embedded in the backend process using
# CHROMA_PERSIST_DIR above. docker/docker-compose.yml sets CHROMA_HOST=chroma
# to switch the backend to talk to Chroma's own container over HTTP instead.
CHROMA_HOST=
CHROMA_PORT=8000

# Frontend — base URL of the running backend. docker/docker-compose.yml
# overrides this to http://backend:8000 for the frontend container.
BACKEND_URL=http://127.0.0.1:8000
