# Copy this file to .env and fill in real values. Never commit .env itself.

# Groq (LLM generation) — https://console.groq.com/keys
GROQ_API_KEY=

# Google AI Studio (Gemini embeddings) — https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Chroma (vector store) — local directory it persists data to, created automatically
CHROMA_PERSIST_DIR=project/storage/.chroma_data

# Frontend — base URL of the running backend
BACKEND_URL=http://127.0.0.1:8000
